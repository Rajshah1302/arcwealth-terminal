# Deployer / keeper key for Arc Testnet (testnet only, never reuse). Generate with: bun run scripts/gen-key.ts
DEPLOYER_PRIVATE_KEY=
# Optional: Circle API key for App Kit Swap/Earn/Borrow (P1)
CIRCLE_API_KEY=
# Arc Testnet RPC (defaults to https://rpc.testnet.arc.io)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Postgres connection string for the backend
DATABASE_URL=postgres://arcwealth:arcwealth@127.0.0.1:5432/arcwealth
# Backend port
API_PORT=3001
ARC_TESTNET_FALLBACK_RPCS=https://rpc.blockdaemon.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.quicknode.testnet.arc.io
